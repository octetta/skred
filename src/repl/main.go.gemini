}
*/

func processCommand(code string) string {
  target := "127.0.0.1:60440"

  // Resolve the address for DialUDP
  remoteAddr, err := net.ResolveUDPAddr("udp", target)
  if err != nil {
    return fmt.Sprintf("Resolve Error: %v", err)
  }

  // DialUDP keeps the same local port open for the response
  conn, err := net.DialUDP("udp", nil, remoteAddr)
  if err != nil {
    return fmt.Sprintf("Dial Error: %v", err)
  }
  defer conn.Close()

  // ADDED: Newline terminator (\n)
  // Many UDP servers require this to trigger a response
  payload := []byte(code + "\n")
  _, err = conn.Write(payload)
  if err != nil {
    return fmt.Sprintf("Send Error: %v", err)
  }

  // Set a 2-second timeout so the UI doesn't hang if the server is silent
  conn.SetReadDeadline(time.Now().Add(2 * time.Second))

  // Read from the exact same socket
  buffer := make([]byte, 8192)
  n, err := conn.Read(buffer)
  if err != nil {
    if netErr, ok := err.(net.Error); ok && netErr.Timeout() {
      return "Sent (No response received - Timeout)"
    }
    return fmt.Sprintf("Read Error: %v", err)
  }

  return string(buffer[:n])
}

