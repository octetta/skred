package main

import (
	_ "embed"
	"fmt"
	. "modernc.org/tk9.0"
	. "modernc.org/tk9.0/extensions/eval"
)

// Embed the tkcon.tcl file
//go:embed tkcon.tcl
var tkconScript string

var pendingCommand string
var commandResult string

func main() {
	// Initialize the eval extension
	InitializeExtension("eval")

	// Hide the default root window
	Eval("wm withdraw .")

	// Load tkcon
	Eval(tkconScript)

	// Configure tkcon
	Eval(`
		catch {
			::tkcon::OPT(exec) ""
			::tkcon::OPT(font) {Courier 10}
			::tkcon::OPT(showmultiple) 1
		}
	`)

	// Create variables for communication
	Eval(`
		set ::pendingCommand ""
		set ::commandResult ""
	`)

	// Create a button whose command callback we control from Go
	// We'll create it in a hidden toplevel
	Eval("toplevel .gohidden")
	Eval("wm withdraw .gohidden")
	
	// Create the button with the Go callback
	TButton(Command(func() {
		// This runs safely in the Tk event loop!
		cmd, _ := Eval("set ::pendingCommand")
		if cmd != "" {
			result := processCommand(cmd)
			
			// Set the result in Tcl
			Eval("set ::_go_temp_result {" + result + "}")
			Eval("set ::commandResult $::_go_temp_result")
			
			// Clear pending
			Eval("set ::pendingCommand \"\"")
		}
	}))
	
	// The button was created as a child of root, get its path first
	btnPath, _ := Eval("lindex [winfo children .] end")
	
	// Now pack it into the hidden window
	Eval(fmt.Sprintf("pack %s -in .gohidden", btnPath))

	// Get the command string from the button
	cmdString, _ := Eval(fmt.Sprintf("%s cget -command", btnPath))

	// Create override for tkcon that calls our Go function via the command
	Eval(fmt.Sprintf(`
		# Save original EvalCmd
		rename ::tkcon::EvalCmd ::tkcon::EvalCmd_orig
		
		proc ::tkcon::EvalCmd {w cmd} {
			# Set the output mark like the original does
			$w mark set output end
			
			# Add to history (this is what the original does)
			if {$cmd ne ""} {
				history add $cmd
			}
			
			# Prepare for Go processing
			set ::pendingCommand $cmd
			set ::commandResult ""
			
			# Trigger the Go callback
			%s
			
			# Get result
			set result $::commandResult
			
			# Insert the result with stdout tag (like original does on success)
			if {$result ne ""} {
				$w insert output $result stdout
			}
			
			# Call Prompt to show next prompt (like original does)
			::tkcon::Prompt
		}
	`, cmdString))

	// Show tkcon
	Eval("tkcon show")

	// Print welcome message
	Eval(`puts "Go REPL ready - type commands and press Enter"`)
	Eval(`puts "Use up/down arrows to navigate history"`)

	// Run the event loop
	App.Wait()
}

// Your command processor
func processCommand(code string) string {
	// This is where you handle the user's input
	fmt.Printf("Go received: %s\n", code)
	return fmt.Sprintf("=> %s", code)
}
