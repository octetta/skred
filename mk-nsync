#!/bin/bash

mkdir -p tmp

if [! -d tmp/nsync ]; then
  cd tmp
  git clone https://github.com/google/nsync.git
  cd nsync
  git checkout 5b420ef # this is where i was on 2026-01-22 @ 12:30 CST
  cd ../..
fi

SRC_REPO="./tmp/nsync"
DEST_DIR="./src/nsync_local"

# 1. Clean and Create structure
rm -rf "$DEST_DIR"
mkdir -p "$DEST_DIR/public"
mkdir -p "$DEST_DIR/internal"
mkdir -p "$DEST_DIR/platform/posix"
mkdir -p "$DEST_DIR/platform/win32"
mkdir -p "$DEST_DIR/platform/gcc"
mkdir -p "$DEST_DIR/platform/gcc_new"

echo "Extracting nsync components..."

# 2. Headers - Copying ALL internal headers to be safe
cp "$SRC_REPO"/public/*.h "$DEST_DIR/public/"
cp "$SRC_REPO"/internal/*.h "$DEST_DIR/internal/"
# Specifically ensuring time headers are caught
find "$SRC_REPO/platform/posix" -name "*.h" -exec cp {} "$DEST_DIR/internal/" \;

# 3. Proxy Headers
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" || "$OSTYPE" == "cygwin" ]]; then
    cp "$SRC_REPO"/platform/win32/platform.h "$DEST_DIR/internal/platform.h"
    cp "$SRC_REPO"/platform/msvc/compiler.h "$DEST_DIR/internal/compiler.h"
    cp "$SRC_REPO"/platform/x86_64/cputype.h "$DEST_DIR/internal/cputype.h"
else
    cp "$SRC_REPO"/platform/posix/platform.h "$DEST_DIR/internal/platform.h"
    cp "$SRC_REPO"/platform/gcc/compiler.h "$DEST_DIR/internal/compiler.h"
    find "$SRC_REPO/platform" -name "cputype.h" -exec cp {} "$DEST_DIR/internal/cputype.h" \; -quit
fi

# 4. Logic Files
cp "$SRC_REPO"/internal/mu.c "$DEST_DIR/internal/"
cp "$SRC_REPO"/internal/common.c "$DEST_DIR/internal/"
cp "$SRC_REPO"/internal/wait.c "$DEST_DIR/internal/"
cp "$SRC_REPO"/internal/dll.c "$DEST_DIR/internal/"
cp "$SRC_REPO"/internal/time_internal.c "$DEST_DIR/internal/"

# 5. Platform Files
cp "$SRC_REPO"/platform/posix/src/per_thread_waiter.c "$DEST_DIR/platform/posix/"
cp "$SRC_REPO"/platform/posix/src/yield.c "$DEST_DIR/platform/posix/"
cp "$SRC_REPO"/platform/posix/src/nsync_panic.c "$DEST_DIR/platform/posix/"
cp "$SRC_REPO"/platform/posix/src/nsync_semaphore_sem_t.c "$DEST_DIR/platform/posix/sem.c"
cp "$SRC_REPO"/platform/posix/src/time_rep.c "$DEST_DIR/platform/posix/time_rep.c"

# 6. Atomics
cp "$SRC_REPO"/platform/gcc/atomic.h "$DEST_DIR/platform/gcc/"
cp "$SRC_REPO"/platform/gcc_new/atomic.h "$DEST_DIR/platform/gcc_new/"

echo "Verification: Checking for nsync_time_init.h..."
ls -l "$DEST_DIR/internal/nsync_time_init.h"

echo "Now test this mess..."

gcc -I./src \
  -I./src/nsync_local/public \
  -I./src/nsync_local/internal \
  -I./src/nsync_local/platform/gcc \
  src/skqueue.c \
  src/nsync_local.c \
  queue_test.c \
  -o queue_test \
  -lpthread -lrt

./queue_test
